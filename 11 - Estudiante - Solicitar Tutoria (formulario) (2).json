      "parameters": {
        "jsCode": "const horarios = $('Sub-workflow - Calcular Disponibilidad').first().json.horarios || [];\nconst tutores = $input.all().map(i => i.json);\nconst idsUnicos = [...new Set(horarios.map(h => h.id_tutor))];\nconst opciones = idsUnicos.map(id => {\n  const t = tutores.find(t => t.id_tutor === id);\n  const nombre = t ? t.nombre : id;\n  return { option: `${nombre} (${id})` };\n});\nreturn [{ json: {\n  telegram_user: $('Code - Capturar Pagina 1').first().json.telegram_user,\n  materia: $('Code - Capturar Pagina 1').first().json.materia,\n  fecha: $('Code - Capturar Pagina 1').first().json.fecha,\n  opcionesTutor: opciones,\n  hayTutores: opciones.length > 0\n}}];"
