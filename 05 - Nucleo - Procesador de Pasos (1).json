      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const texto = String($json.mensaje || '').trim().toLowerCase();\nconst si = ['si','sí','s','yes'];\nconst no = ['no','n'];\nif (si.includes(texto)) return { json: { ...$json, valido: true, valor: true } };\nif (no.includes(texto)) return { json: { ...$json, valido: true, valor: false } };\nreturn { json: { ...$json, valido: false } };"
      },
